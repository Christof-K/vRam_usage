<Window x:Class="VRamUsage.Views.HardwareMonitoring.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controllers="clr-namespace:VRamUsage.Controllers.HardwareMonitoring"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=controllers:OverlayViewModel}"
        Title="VRamUsage Overlay"
        Width="270"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding IsAlwaysOnTop}"
        Opacity="{Binding Opacity}"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Window.Resources>
        <!-- Style for compact progress bar -->
        <Style x:Key="MetricProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Track" CornerRadius="2.5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linear gradient for GPU bar -->
        <LinearGradientBrush x:Key="GpuBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Linear gradient for RAM bar -->
        <LinearGradientBrush x:Key="RamBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <!-- Linear gradient for CPU bar -->
        <LinearGradientBrush x:Key="CpuBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Background="#F00F172A" Foreground="#F8FAFC" BorderBrush="#3394A3B8">
            <MenuItem Header="Position sperren" IsCheckable="True" IsChecked="{Binding IsLocked}"/>
            <MenuItem Header="Immer im Vordergrund" IsCheckable="True" IsChecked="{Binding IsAlwaysOnTop}"/>
            <Separator Background="#334155"/>
            <MenuItem Header="Deckkraft / Transparenz">
                <MenuItem Header="100%" Click="OnOpacity100Click"/>
                <MenuItem Header="88% (Standard)" Click="OnOpacity88Click"/>
                <MenuItem Header="75%" Click="OnOpacity75Click"/>
                <MenuItem Header="60%" Click="OnOpacity60Click"/>
            </MenuItem>
            <Separator Background="#334155"/>
            <MenuItem Header="Ausblenden" Click="OnHideClick"/>
            <MenuItem Header="Beenden" Click="OnExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#DE0F172A"
            BorderBrush="#3394A3B8"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10,12,10"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.45" ShadowDepth="2" Direction="270" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header Row: GPU Model & CPU Load -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GpuName}" 
                               Foreground="#E2E8F0" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#2038BDF8" CornerRadius="4" Padding="5,1,5,1">
                    <TextBlock Foreground="#38BDF8" FontSize="10" FontWeight="Bold">
                        <Run Text="GPU "/>
                        <Run Text="{Binding GpuLoadText, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- VRAM Section -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="VRAM" Foreground="#94A3B8" FontSize="10" FontWeight="Medium"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding VramSummaryText}" 
                           Foreground="#F8FAFC" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Right"/>
            </Grid>

            <ProgressBar Value="{Binding VramPercentage, Mode=OneWay}" 
                         Maximum="100" 
                         Foreground="{StaticResource GpuBrush}" 
                         Style="{StaticResource MetricProgressBarStyle}" 
                         Margin="0,0,0,3"/>

            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding VramSharedText}" Foreground="#64748B" FontSize="9"/>
                <TextBlock Grid.Column="1" Text="{Binding VramDedicatedText}" Foreground="#64748B" FontSize="9"/>
            </Grid>

            <Separator Background="#1E293B" Margin="0,0,0,7"/>

            <!-- System RAM Section -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="System-RAM" Foreground="#94A3B8" FontSize="10" FontWeight="Medium"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding RamSummaryText}" 
                           Foreground="#F8FAFC" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Right"/>
            </Grid>

            <ProgressBar Value="{Binding RamPercentage, Mode=OneWay}" 
                         Maximum="100" 
                         Foreground="{StaticResource RamBrush}" 
                         Style="{StaticResource MetricProgressBarStyle}" 
                         Margin="0,0,0,7"/>

            <!-- CPU Section -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU Auslastung" Foreground="#94A3B8" FontSize="10" FontWeight="Medium"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding CpuLoadText}" 
                           Foreground="#F8FAFC" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Right"/>
            </Grid>

            <ProgressBar Value="{Binding CpuLoadValue, Mode=OneWay}" 
                         Maximum="100" 
                         Foreground="{StaticResource CpuBrush}" 
                         Style="{StaticResource MetricProgressBarStyle}"/>

            <!-- Footer indicator when locked / subtle status -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding LastUpdatedText}" Foreground="#475569" FontSize="8"/>

                <TextBlock Grid.Column="1" 
                           Foreground="#64748B" 
                           FontSize="8" 
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Ziehen zum Bewegen"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter Property="Text" Value="Fixiert"/>
                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</Window>
